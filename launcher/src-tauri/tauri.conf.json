{
  "$schema": "../../app/node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HSL2 Launcher",
  "version": "2.0.0",
  "identifier": "com.hikari.hsl2.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HSL2 Launcher",
        "width": 720,
        "height": 560,
        "minWidth": 660,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/HSL2.png",
      "icons/HSL2.ico"
    ]
  }
}
