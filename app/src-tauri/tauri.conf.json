{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hikari Server Launcher",
  "version": "0.1.0",
  "identifier": "com.hikari.serverlauncher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hikari Server Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
